#!/bin/sh
set -eu

echo "  HOOK   pre-commit"
cd "$(git rev-parse --show-toplevel)"

echo "  TEST   ara"
(cd src && cargo test --quiet 2>/dev/null) || {
    echo "  FAIL   ara tests failed, commit blocked"
    exit 1
}

echo "  LINT   ara"
(cd src && cargo clippy -- -D clippy::unwrap_used -D clippy::expect_used -D clippy::panic -D clippy::cargo 2>/dev/null) || {
    echo "  FAIL   ara clippy failed, commit blocked"
    exit 1
}

echo " CHECK-FMT   ara"
(cd src && cargo fmt -- --check) || {
    echo "  FAIL   ara code is not formatted, commit blocked"
    exit 1
}

if command -v cargo-audit >/dev/null 2>&1; then
    echo "  AUDIT  ara"
    (cd src && cargo audit 2>/dev/null) || {
        echo "  FAIL   ara audit failed, commit blocked"
        exit 1
    }
fi

if command -v cargo-deny >/dev/null 2>&1; then
    echo "  DENY   ara"
    (cargo deny --workspace check 2>/dev/null) || {
        echo "  FAIL   ara deny failed, commit blocked"
        exit 1
    }
fi

if command -v cargo-udeps >/dev/null 2>&1; then
    echo "  UDPES  ara"
    (cd src && cargo udeps 2>/dev/null) || {
        echo "  FAIL   ara udeps failed, commit blocked"
        exit 1
    }
fi

echo "  PASS   all checks"
